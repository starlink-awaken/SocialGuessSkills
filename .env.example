.env.example - environment variable template for project

# API keys
# ANTHROPIC_API_KEY: Anthropic/Claude API key (required for real model calls)
ANTHROPIC_API_KEY=

# GLM-4.7 Configuration (智谱AI)
# GLM_API_KEY: Get API key from https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
# GLM_MODEL: glm-4-flash (default) or glm-4
GLM_MODEL=glm-4-flash
# GLM_TIMEOUT: Request timeout in ms (default: 30000)
GLM_TIMEOUT=30000
# GLM_MAX_RETRIES: Maximum retry attempts (default: 3)
GLM_MAX_RETRIES=3

# Limits and concurrency
# MAX_TOKENS: per-request hard token limit (default: 50000)
MAX_TOKENS=50000
# MAX_CONCURRENT: number of concurrent requests allowed (default: 3)
MAX_CONCURRENT=3

# Budgeting
# MONTHLY_BUDGET: monthly budget in USD used by cost estimators and alerts (default: 50)
MONTHLY_BUDGET=50

# Logging
# LOG_LEVEL: one of fatal,error,warn,info,debug,trace,silent (default: info)
LOG_LEVEL=info

# Retry/backoff
# MAX_RETRIES: maximum retry attempts for network calls (default: 3)
MAX_RETRIES=3
# RETRY_BASE_DELAY_MS: base delay in ms for exponential backoff (default: 1000)
RETRY_BASE_DELAY_MS=1000
# RETRY_MAX_DELAY_MS: cap delay in ms for exponential backoff (default: 30000)
RETRY_MAX_DELAY_MS=30000
