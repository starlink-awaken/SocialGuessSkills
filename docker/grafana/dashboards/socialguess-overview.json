{
  "uid": "socialguess-overview",
  "title": "SocialGuess Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "MCP Request Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mcp_request_total[5m])",
          "legendFormat": "rate"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(mcp_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GLM Cost",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(glm_api_cost_usd_total[1h])",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Workflow Iterations",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(workflow_iterations_total[5m])",
          "legendFormat": "iterations"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_memory_usage_bytes",
          "legendFormat": "memory"
        }
      ]
    }
  ]
}
